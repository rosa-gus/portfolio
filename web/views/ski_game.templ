package views

import "fmt"

const skiGameVersion = "0.1.0"

templ SkiGame(basePath string) {
	@Window(WindowOptions{
		ID: "ski-game", Title: "ski.ts", Class: "ski-game", Width: "48rem", Decoration: "tab",
		Attributes: templ.Attributes{"data-popup": "ski", "data-ski-assets": string(siteURL(basePath, "/ski/sprites"))},
	}, WindowSlots{Information: skiInformation(), Commands: skiCommands(), Touch: skiTouch(), Help: skiHelp(), Tips: skiTips()}) {
		<div class="window__media ski-game__board" data-window-media style="--window-aspect:16 / 9;">
			<canvas width="640" height="360" tabindex="0" data-ski-canvas aria-label="Pista de esqui. Esquerda e direita orientam os esquis; a direção se mantém ao soltar. Baixo aponta para a descida. Espaço pausa." role="img"></canvas>
			<div class="window__message game-message ski-game__message" data-ski-message role="status">
				<div class="ski-game__message-content">
					<section data-ski-intro aria-label="Sobre o jogo" hidden>
						@GameMetadata("SKI", "esquie entre obstáculos.\ncuidado com a companhia.") {
							<dl class="game-metadata__fields">
								<div><dt>AUTOR</dt><dd>rosa gus</dd></div>
								<div><dt>INSPIRAÇÃO</dt><dd class="game-metadata__inline"><span>SkiFree</span><span class="inline-divider inline-divider--small" aria-hidden="true"></span><span class="visually-hidden"> de </span><span>Chris Pirih</span></dd></div>
								<div><dt>VERSÃO</dt><dd>v{ skiGameVersion }</dd></div>
							</dl>
						}
					</section>
					<p data-ski-message-text>Uma pista pela frente.</p>
					<p data-ski-game-over hidden>
						Fim da descida.<br/>
						<span class="ski-game__wave">
							<span class="ski-game__sr-only">Alguém alcançou você.</span>
							<span aria-hidden="true">
								for index, letter := range []rune("Alguém alcançou você.") {
									<span class="ski-game__wave-letter" style={ fmt.Sprintf("--wave-delay: %dms;", index*45) }>{ string(letter) }</span>
								}
							</span>
						</span>
					</p>
					<dl class="ski-game__results" data-ski-results hidden>
						<div><dt>PONTOS</dt><dd data-ski-result-score>0</dd></div>
						<div><dt>DISTÂNCIA</dt><dd data-ski-result-distance>0 m</dd></div>
						<div><dt>POR POUCO</dt><dd data-ski-result-near-misses>0</dd></div>
						<div class="ski-game__result-record"><dt data-ski-result-record-label>MELHOR PONTUAÇÃO</dt><dd data-ski-result-best>0</dd></div>
					</dl>
					<p class="ski-game__result-version" data-ski-result-version hidden>v{ skiGameVersion }</p>
				</div>
			</div>
		</div>
	}
}

templ skiInformation() {
	<span>PONTOS <strong data-ski-score>0000</strong></span>
	<div class="ski-game__distance-group">
		<span>DISTÂNCIA <strong data-ski-distance>0000 m</strong></span>
		<span class="ski-game__best">MELHOR <strong data-ski-best>0000 m</strong></span>
	</div>
}

templ skiCommands() {
	<button type="button" data-ski-toggle disabled>[INICIAR]</button><button type="button" data-ski-restart hidden>[REINICIAR]</button><button type="button" data-ski-sound aria-label="Silenciar o jogo" aria-pressed="false">[SOM LIGADO]</button>
}

templ skiTouch() {
	<div class="ski-game__touch" aria-label="Controles de esqui por toque">
		<button type="button" data-ski-control="left" aria-label="Virar à esquerda">@ArrowGlyph("left")</button>
		<button type="button" data-ski-control="downhill" aria-label="Apontar os esquis para baixo">[DESCER]</button>
		<button type="button" data-ski-control="right" aria-label="Virar à direita">@ArrowGlyph("right")</button>
	</div>
}

templ skiHelp() {
	<p><kbd>@ArrowGlyph("left") @ArrowGlyph("right")<span>/ A D</span></kbd><span>Orientar os esquis</span></p>
	<p><kbd>@ArrowGlyph("down")<span>/ S</span></kbd><span>Apontar para baixo</span></p>
	<p><kbd>ESPAÇO</kbd><span>Pausar a descida</span></p>
	<p>Arraste na pista para escolher a orientação. Ela se mantém ao soltar.</p>
}

templ skiTips() {
	<p>Ganhe 10 pontos a cada 10 metros. Passe rente a árvores e pedras, sem bater e mantendo a velocidade de descida, para ganhar +50 por pouco.</p>
	<p>No slalom, antecipe as curvas e alterne entre as aberturas da pista. Os trechos ficam mais exigentes conforme a descida avança.</p>
}
