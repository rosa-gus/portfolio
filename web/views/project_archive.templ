package views

import (
	"fmt"
	"portfolio/internal/portfolio"
)

templ ProjectArchive(archive portfolio.Archive, basePath string) {
	<div class={ templ.KV("project-archive", true), templ.KV("project-archive--empty-cases", len(archive.Projects) == 0) } data-project-archive aria-label="Arquivo de projetos">
		<div class="project-archive__workspace">
			<div class="project-archive__toolbar">
				<p class="project-archive__document-count">
					<span data-archive-complaint-trigger>/ DOCUMENTOS</span><span
	class="inline-divider"
	aria-hidden="true"
></span><span>{ fmt.Sprintf("%d ITENS", len(archive.Items)) }</span>
				</p>
				<button class="text-action" type="button" data-archive-reset hidden>[REORGANIZAR]</button>
			</div>
			@ScrollArea("Documentos do portfólio", "vertical") {
				<div class="project-archive__surface" data-archive-surface role="group" aria-label="Coleções, projetos e links">
					for _, item := range archive.Items {
						@ArchiveItem(item, basePath)
					}
				</div>
			}
			@ProjectArchiveFloating(archive.Folders, basePath)
		</div>
		<div class="project-archive__cases" aria-live="polite">
			for index, project := range archive.Projects {
				@ArchiveCase(project, archive.Projects, index, basePath)
			}
		</div>
		<button
			class="project-archive__scrim"
			type="button"
			data-archive-dismiss
			aria-label="Fechar coleção e voltar ao arquivo"
			tabindex="-1"
			hidden
		></button>
		<p class="visually-hidden" data-archive-announcement role="status"></p>
	</div>
}
