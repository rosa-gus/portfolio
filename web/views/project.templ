package views

import "portfolio/internal/portfolio"

templ ProjectNoteLink(slug string, key string, number string, label string) {
	<a class="project-note__anchor" href={ templ.SafeURL("#project-" + slug + "-" + key) } data-project-anchor={ key }>
		<span class="project-note__number">{ number }</span><span>{ label }</span>
	</a>
}

templ ProjectNoteHeading(slug string, key string, number string, label string) {
	<h2 class="project-note__section-heading meta-text" id={ "project-" + slug + "-" + key + "-heading" }>
		<span>{ number }</span><span class="inline-divider" aria-hidden="true"></span><span>{ label }</span>
	</h2>
}

templ ProjectNoteSection(slug string, key string, number string, label string, content portfolio.MarkdownDocument, basePath string) {
	<section class="project-note__section" id={ "project-" + slug + "-" + key } data-project-section={ key } aria-labelledby={ "project-" + slug + "-" + key + "-heading" } tabindex="-1">
		@ProjectNoteHeading(slug, key, number, label)
		<div class="project-content__prose">
			@renderMarkdown(content, basePath)
		</div>
	</section>
}

templ ProjectContent(project portfolio.Project, basePath string) {
	<article class="project-content project-content--page" style={ projectToneStyle(project.Tone) } data-project-story>

		<div class="project-note">
			<header class="project-note__opening">
				<p class="project-note__coordinate meta-text"><span>/ CASE { project.Index }</span><span>{ project.Year }</span></p>
				<div class="project-content__edition-mark" aria-hidden="true">
					for _, row := range projectFolioGlyphRows(project) {
						<span>{ row }</span>
					}
				</div>
				<div class="project-note__identity">
					<h1><span class="visually-hidden">{ project.Title }</span><span aria-hidden="true">{ projectFolioID(project) }</span></h1>
					<p class="project-note__metadata meta-text">
						<span>{ projectCategoryLabel(project.Category) }</span><span class="inline-divider" aria-hidden="true"></span><span>{ projectStatusLabel(project.Status) }</span>
					</p>
				</div>
				if project.Summary != "" {
					<p class="project-content__standfirst">{ project.Summary }</p>
				}
				<p class="project-note__role"><span class="meta-text">Atuação</span><span>{ projectRoleLabel(project.Role) }</span></p>
			</header>
			<nav class="project-note__index control-text" aria-label="Índice do estudo de caso">
				<p class="project-note__index-label">Nesta nota</p>
				<div class="project-note__index-links">
					@ProjectNoteLink(project.Slug, "context", "01", "Contexto")
					@ProjectNoteLink(project.Slug, "challenge", "02", "Desafio")
					@ProjectNoteLink(project.Slug, "decision", "03", "Decisões")
					@ProjectNoteLink(project.Slug, "result", "04", "Resultado")
					if len(project.Media.Items) > 0 {
						@ProjectNoteLink(project.Slug, "gallery", "05", "Galeria")
					}
					@ProjectNoteLink(project.Slug, "practice", "06", "Ficha")
				</div>
			</nav>
			@ProjectNoteSection(project.Slug, "context", "01", "Contexto", project.CaseStudy.Context, basePath)
			@ProjectNoteSection(project.Slug, "challenge", "02", "Desafio", project.CaseStudy.Challenge, basePath)
			@ProjectNoteSection(project.Slug, "decision", "03", "Decisões", project.CaseStudy.Decision, basePath)
			@ProjectNoteSection(project.Slug, "result", "04", "Resultado", project.CaseStudy.Result, basePath)
			if len(project.Media.Items) > 0 {
				<section class="project-note__section" id={ "project-" + project.Slug + "-gallery" } data-project-section="gallery" aria-labelledby={ "project-" + project.Slug + "-gallery-heading" } tabindex="-1">
					@ProjectNoteHeading(project.Slug, "gallery", "05", "Galeria")
					<div class="project-gallery" data-project-gallery aria-label={ "Galeria de " + project.Title }>
						<div class="project-gallery__viewport" data-gallery-viewport>
							<div class="project-gallery__track">
								for index, image := range project.Media.Items {
									<figure class="project-gallery__slide" data-gallery-slide aria-hidden={ index != 0 }>
										<div class={ galleryMediaClass(image.Note != "") }>
											if image.Note != "" {
												<p class="project-gallery__note" id={ galleryNoteID(project.Slug, image.ID) }>
													<span>[NOTA]</span> { image.Note }
												</p>
											}
											<div class="project-gallery__image-frame">
												<img
													class={ galleryImageClass(image) }
													src={ siteURL(basePath, image.Src) }
													alt={ image.Alt }
													width={ imageDimension(image.Width) }
													height={ imageDimension(image.Height) }
													loading="lazy"
													decoding="async"
													aria-describedby={ galleryDescriptionIDs(project.Slug, image.ID, image.Note != "") }
												/>
											</div>
										</div>
										<figcaption class="project-gallery__caption" id={ galleryCaptionID(project.Slug, image.ID) }>
											<p class="project-gallery__label">{ image.Label }</p>
											<p class="project-gallery__description">{ image.Caption }</p>
										</figcaption>
									</figure>
								}
							</div>
						</div>
						<div class="project-gallery__controls" aria-label="Controles da galeria">
							<span data-gallery-counter aria-live="polite">
								if len(project.Media.Items) > 0 {
									{ galleryCounter(0, len(project.Media.Items)) }
								} else {
									00 / 00
								}
							</span>
							<div>
								<button type="button" data-gallery-expand>[AMPLIAR]</button>
								<button type="button" data-gallery-prev>[ANTERIOR]</button>
								<button type="button" data-gallery-next>[PRÓXIMA]</button>
							</div>
						</div>
					</div>
				</section>
			}
			<section class="project-note__section" id={ "project-" + project.Slug + "-practice" } data-project-section="practice" aria-labelledby={ "project-" + project.Slug + "-practice-heading" } tabindex="-1">
				@ProjectNoteHeading(project.Slug, "practice", "06", "Ficha técnica")
				<dl class="project-note__facts">
					<div><dt class="meta-text">Atuação</dt><dd>{ projectRoleLabel(project.Role) }</dd></div>
					for _, branch := range project.PracticeMap {
						<div>
							<dt class="meta-text">{ capabilityLabel(branch.Capability) }</dt>
							<dd class="project-note__technologies">
								for index, technology := range branch.Technologies {
									if index > 0 {
										<span class="inline-divider inline-divider--small" aria-hidden="true"></span><span class="visually-hidden">; </span>
									}
									<span>{ technology }</span>
								}
							</dd>
						</div>
					}
					if project.License.Name != "" {
						<div><dt class="meta-text">Licença</dt><dd><a href={ externalURL(project.License.URL) } target="_blank" rel="noreferrer noopener">{ project.License.Name } [<span class="ui-arrow ui-arrow--redirect" aria-hidden="true">↑</span>]</a></dd></div>
					}
					if project.Media.CoverCredit.Name != "" {
						<div><dt class="meta-text">Fotografia da capa</dt><dd>
							if project.Media.CoverCredit.AuthorURL != "" {
								<a href={ externalURL(project.Media.CoverCredit.AuthorURL) } target="_blank" rel="noreferrer noopener">{ project.Media.CoverCredit.Name } [<span class="ui-arrow ui-arrow--redirect" aria-hidden="true">↑</span>]</a>
							} else {
								{ project.Media.CoverCredit.Name }
							}
						</dd></div>
					}
				</dl>
				<div class="project-note__resources control-text" aria-label="Recursos do projeto">
					if project.Links.Live != "" {
						<a href={ externalURL(project.Links.Live) } target="_blank" rel="noreferrer noopener">[VISITAR SITE <span class="ui-arrow ui-arrow--redirect" aria-hidden="true">↑</span>]</a>
					}
					if project.Links.Repository != "" {
						<a href={ externalURL(project.Links.Repository) } target="_blank" rel="noreferrer noopener" aria-label={ "Código-fonte: " + repositoryLabel(project.Links.Repository) }>[CÓDIGO-FONTE <span class="ui-arrow ui-arrow--redirect" aria-hidden="true">↑</span>]</a>
					}
					if project.Links.Releases != "" {
						<a href={ externalURL(project.Links.Releases) } target="_blank" rel="noreferrer noopener" aria-label={ "Releases estáveis e experimentais do " + project.Title }>[VERSÕES <span class="ui-arrow ui-arrow--redirect" aria-hidden="true">↑</span>]</a>
					}
				</div>
			</section>
			<footer class="project-note__ending control-text"><a href={ siteURL(basePath, "/#case") }>[VOLTAR AOS CASES]</a></footer>
		</div>
	</article>
}

templ ProjectImageViewer() {
	<dialog class="project-image-viewer" data-project-image-viewer aria-labelledby="project-image-viewer-title" aria-describedby="project-image-viewer-description">
		<div class="project-image-viewer__frame">
			<header class="project-image-viewer__header">
				<span class="meta-text">/ GALERIA</span>
				<button type="button" data-project-image-viewer-close>[FECHAR]</button>
				<p class="project-image-viewer__identity" aria-live="polite" aria-atomic="true">
					<span class="project-image-viewer__counter" data-project-image-viewer-counter></span><span class="inline-divider" aria-hidden="true"></span><span id="project-image-viewer-title" data-project-image-viewer-title>Imagem do projeto</span>
				</p>
			</header>
			<div class="project-image-viewer__media">
				@ScrollArea("Imagem ampliada do projeto", "vertical", ScrollAreaShadowNone) {
					<img data-project-image-viewer-image alt=""/>
				}
			</div>
			<footer class="project-image-viewer__footer">
				<p class="project-image-viewer__description" id="project-image-viewer-description" data-project-image-viewer-description></p>
				<p class="project-image-viewer__note" data-project-image-viewer-note hidden></p>
				<nav class="project-image-viewer__navigation control-text" aria-label="Navegação da imagem ampliada">
					<button type="button" data-project-image-viewer-prev>[ANTERIOR]</button>
					<button type="button" data-project-image-viewer-next>[PRÓXIMA]</button>
				</nav>
			</footer>
		</div>
	</dialog>
}

templ ProjectPage(profile portfolio.ProfileContent, project portfolio.Project, basePath string, publicURL string) {
	<!DOCTYPE html>
	<html lang="pt-BR">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="description" content={ projectMetadataDescription(profile, project) }/>
			@siteIcons(basePath)
			@themeHead()
			<title>{ projectMetadataTitle(profile, project) }</title>
			<link rel="canonical" href={ externalURL(publicProjectURL(publicURL, project.Slug)) }/>
			<meta property="og:locale" content="pt_BR"/>
			<meta property="og:type" content="website"/>
			<meta property="og:site_name" content={ siteMetadataTitle(profile) }/>
			<meta property="og:title" content={ projectMetadataTitle(profile, project) }/>
			<meta property="og:description" content={ projectMetadataDescription(profile, project) }/>
			<meta property="og:url" content={ publicProjectURL(publicURL, project.Slug) }/>
			<meta property="og:image" content={ socialImageURL(publicURL) }/>
			<meta property="og:image:type" content="image/png"/>
			<meta property="og:image:width" content="1000"/>
			<meta property="og:image:height" content="525"/>
			<meta property="og:image:alt" content={ profile.SEO.SocialImageAlt }/>
			<meta name="twitter:card" content="summary_large_image"/>
			<meta name="twitter:title" content={ projectMetadataTitle(profile, project) }/>
			<meta name="twitter:description" content={ projectMetadataDescription(profile, project) }/>
			<meta name="twitter:image" content={ socialImageURL(publicURL) }/>
			<meta name="twitter:image:alt" content={ profile.SEO.SocialImageAlt }/>
			for _, stylesheet := range appStylesheets() {
				<link rel="stylesheet" href={ siteURL(basePath, stylesheet) }/>
			}
			<script type="module" src={ siteURL(basePath, appScript()) }></script>
		</head>
		<body>
			<div class="project-page">
				<header class="project-page__header">
					<div class="project-page__controls">
						<a href={ siteURL(basePath, "/#case") }>[VOLTAR]</a>
						@themeToggle()
					</div>
					<div class="project-page__actions">
						<nav aria-label="Links do projeto">
							if project.Links.Live != "" {
								<a href={ externalURL(project.Links.Live) } target="_blank" rel="noreferrer">
									SITE [<span
	class="ui-arrow ui-arrow--redirect"
	aria-hidden="true"
>↑</span>]
								</a>
							}
							if project.Links.Repository != "" {
								<a href={ externalURL(project.Links.Repository) } target="_blank" rel="noreferrer">
									CÓDIGO [<span
	class="ui-arrow ui-arrow--redirect"
	aria-hidden="true"
>↑</span>]
								</a>
							}
						</nav>
					</div>
				</header>
				<main>
					@ScrollArea("Leitura do estudo de caso", "vertical") {
						@ProjectContent(project, basePath)
					}
				</main>
			</div>
			@ProjectImageViewer()
			@AppWindows(portfolio.HomeArchive, basePath, profile.Contact.SourceURL)
		</body>
	</html>
}
