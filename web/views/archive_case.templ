package views

import "portfolio/internal/portfolio"

templ ArchiveCase(project portfolio.Project, projects []portfolio.Project, index int, basePath string) {
	<article
		class={ archiveCaseClass(index == 0) }
		data-archive-case={ project.Slug }
		aria-labelledby={ "archive-case-title-" + project.Slug }
	>
		<header class="project-archive__case-heading">
			<div class="project-archive__case-topline">
				<div class="project-archive__case-identity">
					<div
						class="project-archive__case-glyph"
						style={ projectToneStyle(project.Tone) }
						aria-hidden="true"
					>
						for _, row := range projectCompactFolioGlyphRows(project) {
							<span>{ row }</span>
						}
					</div>
					<p class="project-archive__case-meta project-archive__case-identification">
						<span>
							CASE / {
								project.Index }
						</span><span>DOCUMENTO EM CONSULTA</span>
					</p>
				</div>
				if project.Links.Live != "" || project.Links.Repository != "" {
					<div class="project-archive__case-links">
						if project.Links.Live != "" {
							<a
								href={ externalURL(project.Links.Live) }
								target="_blank"
								rel="noreferrer noopener"
								aria-label={ "Ver site de " + project.Title + " (abre em nova aba)" }
							>
								[VER SITE <span
	class="ui-arrow ui-arrow--redirect"
	aria-hidden="true"
>↑</span>]
							</a>
						}
						if project.Links.Repository != "" {
							<a
								href={ externalURL(project.Links.Repository) }
								target="_blank"
								rel="noreferrer noopener"
								aria-label={ "Ver código fonte de " + project.Title + " (abre em nova aba)" }
							>
								[CÓDIGO <span
	class="ui-arrow ui-arrow--redirect"
	aria-hidden="true"
>↑</span>]
							</a>
						}
					</div>
				}
			</div>
		</header>
		<div
			class="project-archive__case-cover"
			data-archive-carousel
			role="group"
			aria-roledescription="carrossel"
			aria-label={ "Imagens de " + project.Title }
		>
			if images := projectArchiveImages(project); len(images) > 0 {
				<div
					class="project-archive__case-carousel-viewport"
					id={ "case-carousel-" + project.Slug }
					data-archive-carousel-viewport
				>
					<div class="project-archive__case-carousel-track">
						for imageIndex, image := range images {
							<a
								class="project-archive__case-cover-slide"
								href={ projectURL(basePath, project.Slug) }
								aria-label={ "Abrir case de " + project.Title }
								aria-hidden={ imageIndex != 0 }
								inert?={
							imageIndex !=0 }
							>
								<img
									class="project-archive__case-cover-image"
									data-archive-carousel-image
									data-src={ siteURL(basePath, image.Src) }
									alt={ image.Alt }
									width={ imageDimension(image.Width) }
									height={ imageDimension(image.Height) }
									loading={ archiveImageLoading(index==0 &&
								imageIndex==0) }
									decoding="async"
									if index==0 && imageIndex==0 {
										src={ siteURL(basePath,
								image.Src) }
									}
								/>
							</a>
						}
					</div>
				</div>
			} else {
				<span class="project-archive__case-fallback">{ project.Title }</span>
			}
		</div>
		<div class="project-archive__case-summary">
			<h2 id={ "archive-case-title-" + project.Slug } tabindex="-1">{ project.Title }</h2>
			<p class="project-archive__case-description">{ project.BriefDescription }</p>
			<div class="project-archive__case-meta project-archive__case-category">
				if project.Year != "" {
					<span>{ project.Year }</span><span class="inline-divider" aria-hidden="true"></span>
				}
				<span>{ projectCategoryLabel(project.Category) }</span>
			</div>
		</div>
		<div class="project-archive__case-caption">
			<a
				class="text-action"
				data-archive-case-link
				data-project-slug={ project.Slug }
				href={ projectURL(basePath, project.Slug) }
			>[ABRIR CASE]</a>
			if len(projectArchiveImages(project)) > 1 {
				<div class="project-archive__case-carousel-controls" aria-label="Navegação das imagens">
					<button
						type="button"
						data-archive-carousel-prev
						aria-controls={ "case-carousel-" + project.Slug }
						aria-label="Imagem anterior"
						disabled
					>
						<span
							class="ui-arrow ui-arrow--left"
							aria-hidden="true"
						>↑</span>
					</button>
					<button
						type="button"
						data-archive-carousel-next
						aria-controls={ "case-carousel-" + project.Slug }
						aria-label="Próxima imagem"
					>
						<span
							class="ui-arrow ui-arrow--right"
							aria-hidden="true"
						>↑</span>
					</button>
				</div>
			}
		</div>
		<footer class="project-archive__case-footer">
			<div class="project-archive__case-footer-main">
				<span class="project-archive__case-stack">
					for _, technology := range project.FeaturedStack {
						<abbr title={ technology }>[{ featuredTechnologyLabel(technology) }]</abbr>
					}
				</span>
				if len(project.Relations) > 0 {
					if related, ok := relatedArchiveProject(project.Relations[0].Ref, projects); ok {
						<span class="project-archive__case-relation">
							@Tooltip("archive-relation-" + project.Slug, related.Title, project.Relations[0].Label) {
								<a class="project-archive__case-relation-link" data-archive-related={ related.Slug } href={ projectURL(basePath, related.Slug) } aria-label={ "Consultar projeto relacionado: " + related.Title } aria-describedby={ "archive-relation-" + project.Slug }>
									<span class="ui-arrow" aria-hidden="true">↳</span>
									<span class="project-archive__case-relation-title">{ related.Title }</span>
								</a>
							}
						</span>
					}
				}
			</div>
		</footer>
	</article>
}

func archiveCaseClass(active bool) string {
	if active {
		return "project-archive__case document-fold is-current"
	}
	return "project-archive__case document-fold"
}
