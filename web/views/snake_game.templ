package views

import "portfolio/internal/portfolio"

templ SnakeGame(repository string) {
	{{ app := portfolio.AppBySlug("snake") }}
	@Window(WindowOptions{
		ID: "snake-game", Title: "snake.ts", Class: "snake-game", Width: "26rem", Decoration: "tab",
		Attributes: templ.Attributes{"data-popup": "snake"},
	}, WindowSlots{Information: snakeInformation(), Commands: snakeCommands(), Touch: snakeTouch(), Help: snakeHelp(), Record: appRecord(app, repository)}) {
		<div class="window__media snake-game__board" data-window-media>
			<canvas width="400" height="400" tabindex="0" data-snake-canvas aria-label="Tabuleiro do snake. Controle com as setas ou WASD." role="img"></canvas>
			<div class="window__message game-message" data-snake-message role="status">
				<section data-snake-intro aria-label="Sobre o jogo" hidden>
					@GameMetadata("SNAKE", "o clássico jogo da cobrinha.\nmas desconfie da magia.") {
						@GameCredits(app.Credits)
					}
				</section>
				<p data-snake-message-text data-window-feature-status>Pronto para jogar?</p>
			</div>
		</div>
	}
}

templ snakeInformation() {
	<span>PONTOS <strong data-snake-score>000</strong></span><span>RECORDE <strong data-snake-best>000</strong></span>
}

templ snakeCommands() {
	<button type="button" data-snake-toggle disabled>[INICIAR]</button><button type="button" data-snake-restart hidden>[REINICIAR]</button><button type="button" data-snake-sound aria-label="Silenciar o jogo" aria-pressed="false" disabled>[SOM LIGADO]</button>
}

templ snakeTouch() {
	<div class="snake-game__directions" aria-label="Direção da cobra">
		<button type="button" data-snake-direction="left" aria-label="Esquerda">@ArrowGlyph("left")</button>
		<button type="button" data-snake-direction="up" aria-label="Cima">@ArrowGlyph("up")</button>
		<button type="button" data-snake-direction="down" aria-label="Baixo">@ArrowGlyph("down")</button>
		<button type="button" data-snake-direction="right" aria-label="Direita">@ArrowGlyph("right")</button>
	</div>
}

templ snakeHelp() {
	<p><kbd>@ArrowGlyph("left") @ArrowGlyph("up") @ArrowGlyph("down") @ArrowGlyph("right")<span>/ WASD</span></kbd><span>Mover a cobra</span></p>
	<p><kbd>ESPAÇO</kbd><span>Pausar o jogo</span></p>
	<p>Quadrado: comida. Contorno: bônus. Chapéu: bruxa.</p>
}
