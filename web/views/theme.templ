package views

templ themeHead() {
	<meta name="color-scheme" content="light dark"/>
	<meta name="theme-color" content="#eee9de"/>
	<script>
		(() => {
			const root = document.documentElement;
			const systemTheme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
			let preference = "system";
			try {
				// Keep this early, standalone bootstrap in sync with scripts/storage.ts.
				const key = "portfolio:v1:ui-theme";
				const current = localStorage.getItem(key);
				const previous = localStorage.getItem("ui-theme");
				if (current === null && previous !== null) localStorage.setItem(key, previous);
				localStorage.removeItem("ui-theme");
				const savedPreference = current ?? previous;
				if (savedPreference === "light" || savedPreference === "dark") preference = savedPreference;
			} catch {}
			const theme = preference === "system" ? systemTheme : preference;
			root.dataset.theme = theme;
			root.dataset.themePreference = preference;
			document.querySelector('meta[name="theme-color"]')?.setAttribute("content", theme === "dark" ? "#0a0a09" : "#eee9de");
			document.querySelectorAll("[data-theme-icon]").forEach((icon) => {
				icon.setAttribute("media", icon.getAttribute("data-theme-icon") === theme ? "all" : "not all");
			});
		})();
	</script>
}

templ themeToggle() {
	<button class="theme-toggle" data-theme-toggle type="button" aria-label="Tema atual: sistema. Ativar modo claro">[SISTEMA]</button>
}
